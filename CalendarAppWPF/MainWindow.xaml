<Window x:Class="CalendarAppWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Event Manager"
        Height="640"
        Width="1090"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen">

    <Border Background="#4A4A4A"
            CornerRadius="16"
            BorderThickness="1"
            BorderBrush="#CBCBCB">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="2" Opacity="0.3" Color="#000000"/>
        </Border.Effect>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Border Grid.Column="0"
                    Background="#3A3A3A"
                    CornerRadius="16,0,0,16">
                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,10,0,40">
                        <TextBlock Text="Query Masters" Foreground="#6D8196" FontSize="10" FontWeight="Bold"/>
                        <TextBlock Text="HomeCalendar" Foreground="#FFFFE3" FontSize="22" FontWeight="Bold"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1">
                        <Button Content="Add New Event"
                                Height="40" Margin="0,0,0,10" Padding="15,0" Cursor="Hand"
                                Foreground="#FFFFE3" FontFamily="Segoe UI SemiBold" FontSize="13"
                                HorizontalContentAlignment="Left">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="Transparent" CornerRadius="8" SnapsToDevicePixels="True">
                                        <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#6D8196"/>
                                            <Setter Property="Foreground" Value="#FFFFE3"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <Button Content="Add New Category"
                                Height="40" Margin="0,0,0,10" Padding="15,0" Cursor="Hand"
                                Foreground="#FFFFE3" FontFamily="Segoe UI SemiBold" FontSize="13"
                                HorizontalContentAlignment="Left" Click="Button_AddNewCategory">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="Transparent" CornerRadius="8" SnapsToDevicePixels="True">
                                        <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#6D8196"/>
                                            <Setter Property="Foreground" Value="#FFFFE3"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>

                    <Button Grid.Row="2" Content="Save and Quit"
                            Height="40" Padding="15,0" Cursor="Hand"
                            Foreground="#FFFFE3" FontFamily="Segoe UI SemiBold" FontSize="13"
                            Click="SaveAndClose_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="btnBorder" Background="#6D8196" CornerRadius="8" SnapsToDevicePixels="True">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="btnBorder" Property="Background" Value="#CBCBCB"/>
                                        <Setter Property="Foreground" Value="#4A4A4A"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>

            <!-- Main Content -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="60"/>
                    <RowDefinition Height="70"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="Transparent" MouseLeftButtonDown="Window_MouseDown">
                    <Grid Margin="25,0,10,0">
                        <TextBlock Text="Project Dashboard" VerticalAlignment="Center"
                                   Foreground="#FFFFE3" FontWeight="Medium"/>
                    </Grid>
                </Border>

                <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="25,0">
                    <Button Content="Filter by month"
                            Height="40" Margin="0,0,10,0" Padding="15" Cursor="Hand" Width="112"
                            Foreground="#FFFFE3" FontFamily="Segoe UI SemiBold" FontSize="13"
                            Click="Button_Click_1">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="btnBorder" Background="#6D8196" CornerRadius="8" SnapsToDevicePixels="True">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="btnBorder" Property="Background" Value="#CBCBCB"/>
                                        <Setter Property="Foreground" Value="#4A4A4A"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Button Content="Filter by category"
                            Height="40" Margin="0,0,10,0" Padding="15,0" Cursor="Hand"
                            Foreground="#FFFFE3" FontFamily="Segoe UI SemiBold" FontSize="13" Width="112">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="btnBorder" Background="#6D8196" CornerRadius="8" SnapsToDevicePixels="True">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="btnBorder" Property="Background" Value="#CBCBCB"/>
                                        <Setter Property="Foreground" Value="#4A4A4A"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>

                <Border Grid.Row="2"
                        Background="#CBCBCB"
                        Margin="25,0,25,25"
                        CornerRadius="12"
                        BorderBrush="#6D8196"
                        BorderThickness="1">
                    <Grid x:Name="MainContentGrid">
                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="#4A4A4A"
                                   FontSize="16"
                                   Text="No events found"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>