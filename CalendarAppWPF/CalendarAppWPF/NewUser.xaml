<Window x:Class="CalendarAppWPF.NewUser"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Setup"
        Width="550" Height="500"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Border CornerRadius="20"
            Background="#FF2B2B2B"
            ClipToBounds="True">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="102*"/>
                <RowDefinition Height="13*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="#1E293B"
                    CornerRadius="20,20,0,0">
                <Grid>
                    <Button Content="✕"
                            Width="22"
                            HorizontalAlignment="Left"
                            Background="Red"
                            Foreground="White"
                            BorderThickness="0" Margin="518,9,0,9"/>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Background="LightGray" Margin="10,10,10,10" Grid.RowSpan="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="37*"/>
                    <ColumnDefinition Width="13*"/>
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center"
                            HorizontalAlignment="Left"
                            Width="350"
                            Grid.ColumnSpan="2"
                            Margin="100,0,0,0">

                    <TextBlock Text="First Time User ?"
                               FontSize="32"
                               FontWeight="SemiBold"
                               TextAlignment="Center"/>

                    <TextBlock Text="Select where we should store your calendar"
                               FontSize="16"
                               Foreground="#333"
                               TextAlignment="Center"
                               Margin="0,0,0,30"/>

                    <TextBlock Text="Calendar Name"
                               FontSize="16"
                               TextAlignment="Center"/>

                    <TextBox Height="35"
                             Background="#FFF8F8F8"
                             BorderBrush="#CCC"/>

                    <Button Content="Browse"
                            Height="35"
                            Background="#DDD"
                            BorderBrush="#CCC"/>

                    <Button Content="Create"
                            Height="35"
                            Background="#555"
                            Foreground="White"
                            BorderBrush="#444"/>
                </StackPanel>

            </Grid>

        </Grid>
    </Border>
</Window>